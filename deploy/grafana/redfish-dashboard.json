          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (bmc) (redfish_health_status{bmc=~\"$bmc\",health=~\"Warning|Critical\"} == 1) or on(bmc) (0 * redfish_up{bmc=~\"$bmc\"})",
          "legendFormat": "{{bmc}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Unhealthy resources",
      "type": "stat"
